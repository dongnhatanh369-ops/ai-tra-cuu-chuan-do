# Copy this file to .env for local development.
# Never commit real API keys.

APP_ENV=development
APP_NAME=ai-tra-cuu-chuan-do
API_HOST=127.0.0.1
API_PORT=8000

# AI provider configuration (add only when AI integration begins)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Database configuration (SQLite for MVP; PostgreSQL can be used later)
DATABASE_URL=sqlite:///./data/app.db
